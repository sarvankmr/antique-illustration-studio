# Create this file as .env.local (never commit real secrets).
OPENAI_API_KEY=sk-your-openai-api-key
# Choose a strong passphrase. Required even if the website is public.
STUDIO_ACCESS_CODE=change-this-to-a-strong-private-password
# A separate 32+ character random string to sign login cookies.
SESSION_SECRET=replace-with-an-independent-random-64-char-secret
# Optional model; see supported image models in OpenAI docs.
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
